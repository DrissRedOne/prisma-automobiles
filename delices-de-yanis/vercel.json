{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/menu",
      "destination": "/carte",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/cuisine",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/commande",
      "destination": "/app"
    },
    {
      "source": "/commandes",
      "destination": "/app"
    },
    {
      "source": "/suivi/:id",
      "destination": "/app"
    },
    {
      "source": "/cuisine",
      "destination": "/cuisine-app"
    },
    {
      "source": "/cuisine/:page*",
      "destination": "/cuisine-app"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(manifest|cuisine).webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
