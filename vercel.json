{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/vehicules/all",
      "destination": "/vehicules",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/vehicule-occasion/:annonce",
      "destination": "/app"
    },
    {
      "source": "/vehicules/:categorie",
      "destination": "/app"
    },
    {
      "source": "/options",
      "destination": "/app"
    },
    {
      "source": "/coordonnees",
      "destination": "/app"
    },
    {
      "source": "/compte",
      "destination": "/app"
    },
    {
      "source": "/reservation/:id",
      "destination": "/app"
    },
    {
      "source": "/paiement/:id",
      "destination": "/app"
    },
    {
      "source": "/gestion",
      "destination": "/app"
    },
    {
      "source": "/gestion/:page*",
      "destination": "/app"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
